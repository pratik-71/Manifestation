{
  "expo": {
    "name": "Manifestation",
    "slug": "manifestation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "manifestation",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pratik71.Manifestation",
      "buildNumber": "1.0.1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Manifestation to access your camera to record your future message.",
        "NSMicrophoneUsageDescription": "Allow Manifestation to access your microphone to record audio for your future message.",
        "NSPhotoLibraryUsageDescription": "Allow Manifestation to access your photos to save and view your recorded future messages.",
        "NSPhotoLibraryAddUsageDescription": "Allow Manifestation to save your recorded future message to your gallery.",
        "LSApplicationQueriesSchemes": [
          "itms-apps"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#02010a",
        "foregroundImage": "./assets/images/android-icon-foreground-smaller.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-smaller.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.pratik71.Manifestation",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#02010a",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Manifestation to access your camera to record your future message.",
          "microphonePermission": "Allow Manifestation to access your microphone to record audio for your future message.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Manifestation to access your photos to save your recorded future message.",
          "savePhotosPermission": "Allow Manifestation to save your recorded future message to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
