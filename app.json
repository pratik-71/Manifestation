{
  "expo": {
    "name": "Manifestation",
    "slug": "manifestation",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "manifestation",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pratik71.Manifestation",
      "buildNumber": "1.0.43",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Manifestation needs camera access so you can record visual affirmations and send video messages to your future self.",
        "NSMicrophoneUsageDescription": "We need microphone access to capture the sound and voice for your future-self video recordings and meditations.",
        "NSPhotoLibraryUsageDescription": "This allows you to save your recorded manifestation journeys and future-self videos directly to your Photo Library.",
        "NSPhotoLibraryAddUsageDescription": "We need permission to add your recorded manifestations to your gallery so you can cherish them forever.",
        "LSApplicationQueriesSchemes": [
          "itms-apps"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserTrackingUsageDescription": "This identifier will be used to provide a better and more personalized experience for your manifestations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#02010a",
        "foregroundImage": "./assets/images/android-icon-foreground-smaller.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-smaller.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.pratik71.Manifestation",
      "versionCode": 19,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.VIBRATE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#02010a",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Manifestation to access your camera to record your future message.",
          "microphonePermission": "Allow Manifestation to access your microphone to record audio for your future message.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Manifestation to access your photos to save your recorded future message.",
          "savePhotosPermission": "Allow Manifestation to save your recorded future message to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-apple-authentication",
      "expo-video",
      "expo-tracking-transparency",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "abbfa704-d476-4d13-98bf-a9b7ff04ce92"
      }
    },
    "owner": "papaya-studio"
  }
}
